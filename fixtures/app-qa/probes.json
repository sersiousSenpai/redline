{
  "$comment": [
    "What scripts/app-visual-qa.mjs measures on each scene of the workbench walk.",
    "A probe finds ONE element: the first `css` candidate that matches a visible element, else the smallest visible element whose whole text is `text` (or starts with it, `textStarts`), searched inside the first visible `within` match when given, then `.closest(up)` when `up` is given.",
    "`expect` keys: x, y, width, height, maxWidth (<=), minWidth (>=), fontSize, fontWeight, lineHeight, letterSpacing, borderRadius, paddingTop/Right/Bottom/Left, gap: numbers in px (±1, weight exact). `fontFamily~` is a substring test. A probe with no `expect` only has to be found.",
    "`tokens` maps a computed colour property (color, backgroundColor, borderTopColor, …) to the CSS custom property it must resolve to.",
    "`copy` lists strings that must appear verbatim in the page's rendered text; `absent` lists strings that must not.",
    "`all` runs on every scene; the named sets run on their scene."
  ],
  "all": [
    { "name": "tab strip", "css": [".rl-wb-strip"], "expect": { "height": 34, "fontSize": 13 } },
    { "name": "active tab", "css": [".rl-wb-strip [role=tab][aria-selected=true]"], "expect": { "height": 34 } },
    { "name": "top bar (RLTopBar: six elements, D26)", "css": ["header.rl-topbar"], "expect": { "height": 38, "fontSize": 13, "paddingLeft": 84 } },
    { "name": "top bar sidebar toggle", "css": [".rl-topbar > .rl-topbar-btn:first-child"], "expect": { "width": 26, "height": 26 } },
    { "name": "top bar title", "css": [".rl-topbar-title .rl-topbar-name"], "expect": { "fontSize": 13, "fontWeight": 600 } },
    { "name": "top bar command field", "css": [".rl-topbar-field[data-tour=command]"], "expect": { "height": 26, "maxWidth": 420, "fontSize": 12, "borderRadius": 7 } },
    { "name": "top bar need you", "css": [".rl-topbar-needs"], "expect": { "height": 24, "fontSize": 12, "fontWeight": 600 } },
    { "name": "top bar gear", "css": [".rl-topbar [data-tour=settings] > button"], "expect": { "width": 26, "height": 26 } },
    { "name": "status bar", "css": [".rl-statusbar"], "expect": { "height": 28 } },
    { "name": "status bar Memory chip", "css": [".rl-footer-status .rl-mem-chip"], "expect": { "height": 20 } },
    { "name": "status bar live session", "css": [".rl-footer-meta .rl-live-chip"], "expect": { "height": 20 } }
  ],
  "home": {
    "copy": ["Home", "Browser", "Localhost", "Din backend: Hono + Fly", "Din retrieval plan", "Din roadmap: next steps", "Plans", "Chats"],
    "absent": ["Runs", "Plan a build"],
    "probes": [
      { "name": "sidebar", "css": [".rl-sb"] },
      { "name": "door plate", "css": [".rl-wb-door-plate"] },
      { "name": "island", "css": [".rl-fd-island"] },
      { "name": "door prompt", "css": [".rl-fd-island .rl-fd-input", ".rl-fd-input"] },
      { "name": "session row title", "within": ".rl-sb", "text": "Din roadmap: next steps", "expect": { "fontSize": 13 } }
    ]
  },
  "door-tab": {
    "probes": [
      { "name": "second tab", "css": [".rl-wb-strip [role=tab]:nth-of-type(2)", ".rl-wb-strip [role=tab] ~ [role=tab]"], "expect": { "height": 34 } }
    ]
  },
  "plan": {
    "$comment": "D29: a row opens its plan as a tab of the set on screen (Home), beside the door; its Agent tab comes from its terminal's row.",
    "copy": ["Din roadmap: next steps", "Plan"],
    "probes": [
      { "name": "sidebar", "css": [".rl-sb"] },
      { "name": "Plan tab (titled after the plan)", "css": [".rl-wb-strip [role=tab][title^='Din roadmap: next steps']"], "expect": { "height": 34 } },
      { "name": "plan pane", "css": [".rl-plan-pane"] },
      { "name": "plan title", "within": ".rl-plan-pane", "text": "Din roadmap: next steps", "up": "h1" }
    ]
  },
  "agent": {
    "copy": ["Chat", "CLI", "Claude Code"],
    "probes": [
      { "name": "sidebar", "css": [".rl-sb"] },
      { "name": "agent pane", "css": [".rl-agent-pane"] },
      { "name": "agent pane header", "css": [".rl-agent-pane .rl-agent-head"], "expect": { "height": 28 } },
      { "name": "Chat radio", "within": ".rl-agent-head", "text": "Chat", "up": "[role=radio]" },
      { "name": "CLI radio", "within": ".rl-agent-head", "text": "CLI", "up": "[role=radio]" },
      { "name": "conversation", "css": [".rl-agent-pane .rl-convo"] },
      { "name": "compact composer (D27)", "css": [".rl-agent-pane [data-compact-composer]"], "expect": { "maxWidth": 720, "borderRadius": 14, "paddingTop": 14, "paddingLeft": 14 } },
      { "name": "composer chip", "css": [".rl-agent-pane [data-compact-composer] .rl-convo-chip"], "expect": { "height": 32, "borderRadius": 18 } },
      { "name": "composer mic", "css": [".rl-agent-pane [data-compact-composer] .rl-convo-mic"], "expect": { "width": 32, "height": 32 } }
    ]
  },
  "agent-cli": {
    "probes": [
      { "name": "agent pane header", "css": [".rl-agent-pane .rl-agent-head"], "expect": { "height": 28 } },
      { "name": "CLI box", "css": [".rl-agent-pane .rl-agent-cli"] }
    ]
  },
  "browser": {
    "$comment": "The browser surface hides the sidebar (an immersive surface), so no sidebar probe here; its page is a faked webview.",
    "copy": ["Browser"],
    "probes": [
      { "name": "Browser tab", "css": [".rl-wb-strip [role=tab][title='Browser']"], "expect": { "height": 34 } },
      { "name": "page strip", "css": [".rb-tab-rail"], "expect": { "width": 40 } },
      { "name": "page button", "css": [".rb-tab-rail [role=tab][aria-selected=true]"], "expect": { "width": 28, "height": 28 } },
      { "name": "address bar", "css": [".rb-navigation-row"], "expect": { "height": 40 } },
      { "name": "back", "css": [".rb-navigation-row [aria-label=Back]"], "expect": { "width": 26, "height": 26 } },
      { "name": "address field", "css": [".rb-address"], "expect": { "height": 28, "borderRadius": 8 } },
      { "name": "Page chat", "css": [".rb-chat-toggle"], "expect": { "height": 28 } }
    ]
  },
  "browser-newtab": {
    "copy": ["A place to pick up", "where you left off.", "Browse", "Agent search", "localhost:5173", "portable-pty resize race", "Every page you read is filed in Memory"],
    "probes": [
      { "name": "page strip", "css": [".rb-tab-rail"], "expect": { "width": 40 } },
      { "name": "address bar", "css": [".rb-navigation-row"], "expect": { "height": 40 } },
      { "name": "title", "css": [".rb-nt-head h1"], "expect": { "fontSize": 40 } },
      { "name": "omnibox", "css": [".rb-nt-omnibox"], "expect": { "borderRadius": 18 } },
      { "name": "Browse verb", "css": [".rb-nt-verb[data-primary]"], "expect": { "height": 30 } },
      { "name": "live chip", "css": [".rb-nt-live .rb-nt-chip"], "expect": { "height": 30 } },
      { "name": "row", "css": [".rb-nt-row"], "expect": { "height": 36 } },
      { "name": "Pick back up", "css": [".rb-nt-section[aria-label='Pick back up']"] },
      { "name": "Reading, by subject", "css": [".rb-nt-section[aria-label='Reading, by subject']"] }
    ]
  },
  "sidebar": {
    "copy": ["Home", "Browser", "Localhost", "Plans", "Chats"],
    "absent": ["Runs"],
    "probes": [
      { "name": "sidebar", "css": [".rl-sb"] },
      { "name": "Places", "css": [".rl-sb .rl-sb-places"] },
      { "name": "Home place", "within": ".rl-sb-places", "text": "Home", "up": "button, [role=button], a" },
      { "name": "project group label", "css": [".rl-sb .rl-sb-section .rl-sb-label"], "expect": { "fontSize": 11 } },
      { "name": "session row title", "within": ".rl-sb", "text": "Din roadmap: next steps", "expect": { "fontSize": 13 } },
      { "name": "Browser place (D30)", "css": [".rl-sb-places .rl-sb-place[data-place=browser]"] },
      { "name": "Plans group header (D31)", "css": [".rl-sb .rl-sb-group[data-group=plans] .rl-sb-group-head"], "expect": { "height": 22 } },
      { "name": "Chats group header (D31)", "css": [".rl-sb .rl-sb-group[data-group=chats] .rl-sb-group-head"], "expect": { "height": 22 } },
      { "name": "group count", "css": [".rl-sb .rl-sb-group-count"] }
    ]
  },
  "chat": {
    "$comment": "D27: the chat pane's composer is the compact composer, centred under the thread and pinned to the pane's bottom (the drive's waits measure that); the status bar carries no pill and no status words.",
    "copy": ["Review status check", "What are we working on?"],
    "absent": ["Plan a build", "Preparing your reply", "Rate limited"],
    "probes": [
      { "name": "chat room", "css": ["[data-chat-room]"] },
      { "name": "compact composer", "css": ["[data-chat-room] [data-compact-composer]"], "expect": { "maxWidth": 720, "borderRadius": 14, "paddingTop": 14, "paddingLeft": 14 } },
      { "name": "composer field", "css": ["[data-chat-room] [data-compact-composer] .rl-fd-input"], "expect": { "fontSize": 15 } },
      { "name": "composer menu chip", "css": ["[data-chat-room] [data-compact-composer] .rl-composer-chip"], "expect": { "height": 32 } },
      { "name": "mode chip", "css": ["[data-chat-room] [data-compact-composer] .rl-chat-mode-picker > button"], "expect": { "height": 32, "borderRadius": 18 } },
      { "name": "send", "css": ["[data-chat-room] [data-compact-composer] .rl-fd-go"], "expect": { "width": 32, "height": 32 } }
    ]
  },
  "sidebar-click": {
    "$comment": "D29: rows open tabs in the set on screen; the drive's waits are the checks.",
    "probes": [
      { "name": "Plan tab in Home", "css": [".rl-wb-strip [role=tab][title^='Din roadmap: next steps']"], "expect": { "height": 34 } },
      { "name": "door tab kept", "css": [".rl-wb-strip [role=tab][aria-selected=false]"], "expect": { "height": 34 } }
    ]
  }
}
