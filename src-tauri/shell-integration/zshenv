# Redline shell integration. Source the user's startup file with their original
# ZDOTDIR, then keep this shim selected only until the interactive rc completes.
if [[ ${REDLINE_USER_ZDOTDIR_SET:-0} == 1 ]]; then
  export ZDOTDIR="$REDLINE_USER_ZDOTDIR"
else
  unset ZDOTDIR
fi
[[ -r "${ZDOTDIR:-$HOME}/.zshenv" ]] && source "${ZDOTDIR:-$HOME}/.zshenv"
export REDLINE_USER_ZDOTDIR_SET=${+ZDOTDIR}
export REDLINE_USER_ZDOTDIR="${ZDOTDIR:-$HOME}"
export ZDOTDIR="$REDLINE_SHELL_INTEGRATION_DIR"
