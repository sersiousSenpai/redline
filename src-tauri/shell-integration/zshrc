if [[ ${REDLINE_USER_ZDOTDIR_SET:-0} == 1 ]]; then
  export ZDOTDIR="$REDLINE_USER_ZDOTDIR"
else
  unset ZDOTDIR
fi
[[ -r "${ZDOTDIR:-$HOME}/.zshrc" ]] && source "${ZDOTDIR:-$HOME}/.zshrc"
# ZDOTDIR is now the user's value again. Their .zlogin and child shells load
# normally. Preserve all prompt frameworks and add hooks after their setup.
_rl_running=0
_rl_precmd() {
  local result=$?
  (( _rl_running )) && builtin printf '\033]133;D;%s\007' "$result"
  _rl_running=0
  local cwd_value="$PWD" char encoded='' i
  local LC_ALL=C
  for ((i=1;i<=${#cwd_value};i++)); do
    char=${cwd_value[i]}
    if [[ $char == [a-zA-Z0-9/._~-] ]]; then encoded+=$char
    else builtin printf -v char '%%%02X' "'$char"; encoded+=$char; fi
  done
  builtin printf '\033]7;file://localhost%s\007\033]133;A\007' "$encoded"
}
_rl_preexec() {
  local encoded
  encoded=$(builtin printf '%s' "$1" | command base64 | command tr -d '\n')
  builtin printf '\033]633;E;%s\007\033]133;C\007' "$encoded"
  _rl_running=1
}
_rl_prompt_end() {
  [[ "$PROMPT" != *$'\033]133;B\007'* ]] && PROMPT+=$'%{\033]133;B\007%}'
}
typeset -ga precmd_functions preexec_functions
precmd_functions=(_rl_precmd ${precmd_functions:#_rl_precmd})
precmd_functions=(${precmd_functions:#_rl_prompt_end} _rl_prompt_end)
preexec_functions=(_rl_preexec ${preexec_functions:#_rl_preexec})
